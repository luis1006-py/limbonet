#!/bin/bash

set -e
APP_DIR=/opt/isolation_service
VENV_DIR=$APP_DIR/venv

cp /opt/isolation_service/isolation-srv.service /etc/systemd/system/isolation-srv.service

if [ ! -d "$VENV_DIR" ]; then
    python3 -m venv "$VENV_DIR"
fi

"$VENV_DIR/bin/pip" install --upgrade pip
"$VENV_DIR/bin/pip" install -r "$APP_DIR/requirements.txt"
"$VENV_DIR/bin/python" "$APP_DIR/installscript.py"

systemctl daemon-reload
systemctl enable isolation-srv.service
systemctl restart isolation-srv.service

exit 0